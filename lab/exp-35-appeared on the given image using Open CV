import cv2
import numpy as np

# Create white image
img = np.ones((500, 500, 3), dtype=np.uint8) * 255

# Display text on image
text = "WELCOME"

cv2.putText(img, text, (100, 250),
            cv2.FONT_HERSHEY_SIMPLEX,
            1.5, (0, 0, 255), 3)

# Show image
cv2.imshow("Experiment 35 - Text", img)

cv2.waitKey(0)
cv2.destroyAllWindows()